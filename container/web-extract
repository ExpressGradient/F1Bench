#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import urllib.error
import urllib.request

from parallel_usage import begin, finish


def main() -> None:
    parser = argparse.ArgumentParser(description="Extract web pages with Parallel.")
    parser.add_argument("objective", help="what information to extract")
    parser.add_argument("urls", nargs="+", help="one to twenty URLs")
    parser.add_argument("--max-chars", type=int, default=50_000)
    args = parser.parse_args()
    if len(args.urls) > 20:
        parser.error("at most twenty URLs are allowed")

    key = os.getenv("PARALLEL_API_KEY")
    if not key:
        raise SystemExit("PARALLEL_API_KEY is not configured")
    body = {
        "urls": args.urls,
        "objective": args.objective,
        "max_chars_total": args.max_chars,
    }
    if client_model := os.getenv("PARALLEL_CLIENT_MODEL"):
        body["client_model"] = client_model
    request = urllib.request.Request(
        "https://api.parallel.ai/v1/extract",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "x-api-key": key},
        method="POST",
    )
    request_id = begin("extract", len(args.urls))
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            result = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace")
        raise SystemExit(f"Parallel extract failed ({error.code}): {detail}") from error
    except (urllib.error.URLError, TimeoutError) as error:
        raise SystemExit(f"Parallel extract failed: {error}") from error
    finish(request_id, "extract", result)
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
